# ---------------------------------------------------------------------------
# JellySafe Backend 환경 변수 예시
# 실제 값은 .env 로 복사해서 채운다. .env 는 커밋 금지(.gitignore 등록됨).
# ---------------------------------------------------------------------------

# 애플리케이션
NODE_ENV=development
PORT=3000
API_PREFIX=api

# 인증 (JWT) — 운영에서는 반드시 강한 비밀키로 교체
# 32자 이상이어야 기동한다. 아래 값은 개발 전용이며 NODE_ENV=production 에서는 거부된다
# (저장소에 공개돼 있는 값이라 아는 사람은 관리자·게스트 토큰을 둘 다 위조할 수 있다).
#   운영: openssl rand -hex 32
JWT_SECRET=jellysafe-dev-secret-change-me-please-32
# 액세스 토큰 수명. 서버가 취소할 수 없으므로 이 값이 곧 유출 시 최대 노출 시간이다.
# 재발급(POST /admin/auth/refresh)이 있어 짧아도 재로그인이 늘지 않는다. 운영 상한 2h.
JWT_EXPIRES=30m

# 데이터베이스 (MySQL 8)
# Prisma 와 Kysely 가 동일 URL 을 사용한다.
DATABASE_URL="mysql://jellysafe:jellysafe@localhost:3306/jellysafe"

# DB 커넥션 풀 (Kysely mysql2 pool)
DB_POOL_LIMIT=10

# 관리형 MySQL(Aiven/PlanetScale 등) 배포 시 SSL 필수 → DB_SSL=true
# 로컬 개발은 false. Prisma 는 DATABASE_URL 쿼리 파라미터로 SSL 을 처리한다.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# 위험도 룰 버전 (활성 룰셋 지정)
RISK_RULE_VERSION=v1

# AI 판별 (SYS-004). MVP 는 Mock. 실제 모델 연동 시 엔드포인트/키 채움
VISION_AI_MODE=mock
VISION_AI_ENDPOINT=
VISION_AI_API_KEY=

# 배치 스케줄 (cron). 비활성화하려면 SCHEDULER_ENABLED=false
SCHEDULER_ENABLED=true
OBSERVATION_SYNC_CRON="0 */30 * * * *"
RISK_RECALC_CRON="0 5 * * * *"
DAILY_REPORT_CRON="0 10 0 * * *"
