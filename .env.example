# ---------------------------------------------------------------------------
# JellySafe Backend 환경 변수 예시
# 실제 값은 .env 로 복사해서 채운다. .env 는 커밋 금지(.gitignore 등록됨).
# ---------------------------------------------------------------------------

# 애플리케이션
NODE_ENV=development
PORT=3000
API_PREFIX=api

# 인증 (JWT) — 운영에서는 반드시 강한 비밀키로 교체
# 32자 이상이어야 기동한다. 아래 값은 개발 전용이며 NODE_ENV=production 에서는 거부된다
# (저장소에 공개돼 있는 값이라 아는 사람은 관리자·게스트 토큰을 둘 다 위조할 수 있다).
#   운영: openssl rand -hex 32
JWT_SECRET=jellysafe-dev-secret-change-me-please-32
# 액세스 토큰 수명. 서버가 취소할 수 없으므로 이 값이 곧 유출 시 최대 노출 시간이다.
# 재발급(POST /admin/auth/refresh)이 있어 짧아도 재로그인이 늘지 않는다. 운영 상한 2h.
JWT_EXPIRES=30m

# 데이터베이스 (MySQL 8)
# Prisma 와 Kysely 가 동일 URL 을 사용한다.
DATABASE_URL="mysql://jellysafe:jellysafe@localhost:3306/jellysafe"

# DB 커넥션 풀 (Kysely mysql2 pool)
DB_POOL_LIMIT=10

# 관리형 MySQL(Aiven/PlanetScale 등) 배포 시 SSL 필수 → DB_SSL=true
# 로컬 개발은 false. Prisma 는 DATABASE_URL 쿼리 파라미터로 SSL 을 처리한다.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# 위험도 룰 버전 (활성 룰셋 지정)
RISK_RULE_VERSION=v1

# AI 판별 (SYS-004). MVP 는 Mock. 실제 모델 연동 시 엔드포인트/키 채움
VISION_AI_MODE=mock
VISION_AI_ENDPOINT=
VISION_AI_API_KEY=

# 배치 중복 실행을 막는 락. mysql(기본) | memory
#   mysql  : MySQL GET_LOCK. 인스턴스가 여럿이어도 하나만 실행된다. 머신이 하나여도 동작이 같다.
#   memory : 프로세스 안에서만 유효 — 머신을 늘리면 게이트가 조용히 사라진다.
JOB_LOCK_DRIVER=mysql

# 2차 기능(EX-001~004: 제휴 API·구독·모델 관리). false 면 해당 경로가 전부 404.
# 제휴사가 없는 환경에서 /partner/v1/* 을 열어 둘 이유가 없다.
SECONDARY_ENABLED=true

# 공개 조회 응답 캐시 TTL(초). 0 이면 끈다.
# 부하 측정에서 병목이 DB 왕복으로 확인돼 넣었다(docs/load-test.md §5) —
# 프레임워크는 2,453 req/s 를 내는데 집계 질의가 붙으면 804 로 떨어진다.
# 신선도는 TTL 이 아니라 **산출 후 무효화**가 지킨다. 제보 검수로 위험도가 즉시 재산출되면
# 캐시를 비우므로 시민은 TTL 을 기다리지 않고 바로 새 값을 본다.
PUBLIC_CACHE_TTL_SECONDS=30

# 레이트 리밋 한도(IP 기준). 미설정이면 기본값 그대로다.
# 급증(성수기 주말·사고 직후) 때 정상 사용자가 429 를 받기 시작하면 **재배포 없이** 올릴 수
# 있어야 한다 — 안전 정보를 막아 둔 채 배포를 기다릴 수는 없다. 부하 측정 때도 필요하다.
# 0 이하나 숫자가 아닌 값은 기본값으로 되돌린다(오타로 리밋이 사라지면 안 된다).
RATE_LIMIT_DEFAULT_PER_MIN=300
RATE_LIMIT_REPORT_PER_MIN=10
RATE_LIMIT_REPORT_PER_HOUR=60

# 카카오 알림톡 (EX-002 도달 확장). SENS 자격증명을 함께 쓰지만 **별도로 켠다** —
# 카카오 비즈니스 채널과 템플릿 심사 승인이 더 필요하기 때문이다.
# 셋 중 하나라도 비면 비활성이고, 그때는 문자로만 나간다.
#   KAKAO_SERVICE_ID  : 알림톡 서비스 ID (SMS 서비스 ID 와 다르다)
#   KAKAO_CHANNEL_ID  : 발신 프로필 = 카카오 채널 검색용 아이디(@채널명)
#   KAKAO_TEMPLATE_CODES : 사건:승인템플릿코드 목록
# ⚠️ 알림톡은 자유 문구를 보낼 수 없다. 승인 템플릿을 등록할 때 우리 문구 생성기가 만드는
#    형태 그대로 받아야 하며, 문구를 바꾸면 재승인 전까지 발송이 거부된다.
KAKAO_SERVICE_ID=
KAKAO_CHANNEL_ID=
KAKAO_TEMPLATE_CODES=

# 예측 대조 배치(정답 데이터와 과거 예측 맞추기). 기본 새벽 4시.
# 자정 직후가 아닌 이유: 대상이 어제 하루인데 늦게 입력되는 현장 기록(퇴근 후 정리, 119 연계)이
# 아직 안 들어와 오경보로 잘못 세어진다. 'off' 로 끌 수 있다.
PREDICTION_EVALUATION_CRON="0 0 4 * * *"

# ---------------------------------------------------------------------------
# 공공데이터 수집기 인증키
#
# ⚠️ **비워 두면 그 수집기가 조용히 꺼진다.** 경고 로그는 남지만 화면에는 아무 표시가 없고,
#    한참 뒤에 "해파리 데이터가 안 들어온다" 로 드러난다(sync-health 가 zero_yield 로 잡는다).
#    운영에서는 세 개 다 채운다.
#
#   KHOA_API_KEY : 국립해양조사원 해양관측부이.
#                  **해류(유향·유속)와 염분을 주는 유일한 소스다** — 기상청은 관측하지 않는다.
#                  없으면 CURRENT_INFLOW 위험 요인이 통째로 결측이 되고, 그 해변은
#                  데이터 신뢰도가 구조적으로 'high' 에 도달하지 못한다.
#   KMA_API_KEY  : 기상청 해양기상관측 + 해상예보. 수온·파고·풍향과 24h/72h 예보의 원천이다.
#                  없으면 예측 지평(24h/72h)이 현재값으로만 계산된다.
#   NIFS_API_KEY : 국립수산과학원 해파리 주간보고. 인근 해역 출현(NEARBY_ALERT_*)의 원천이다.
#                  없으면 위험도가 관측치만으로 계산돼 실제 출현을 반영하지 못한다.
#
# 발급: 공공데이터포털(data.go.kr) 각 서비스 활용신청 후 발급되는 서비스키.
# ---------------------------------------------------------------------------
KHOA_API_KEY=
KMA_API_KEY=
NIFS_API_KEY=

# 배치 스케줄 (cron). 비활성화하려면 SCHEDULER_ENABLED=false
SCHEDULER_ENABLED=true
OBSERVATION_SYNC_CRON="0 */30 * * * *"
RISK_RECALC_CRON="0 5 * * * *"
DAILY_REPORT_CRON="0 10 0 * * *"
