# ---------------------------------------------------------------------------
# JellySafe Backend 환경 변수 예시
# 실제 값은 .env 로 복사해서 채운다. .env 는 커밋 금지(.gitignore 등록됨).
# ---------------------------------------------------------------------------

# 애플리케이션
NODE_ENV=development
PORT=3000
API_PREFIX=api

# 인증 (JWT) — 운영에서는 반드시 강한 비밀키로 교체
#
# ⚠️ **32자 이상이어야 부팅된다**(env 검증). 예전에는 이 예시값 그대로 운영에 올려도 떴는데,
#    이 키를 아는 사람은 관리자 토큰과 게스트 토큰을 둘 다 위조할 수 있다.
#    이 키는 JWT 서명 + 비로그인 게스트 토큰 HMAC(shared/auth/guest-token.ts)에 함께 쓰인다.
#    ⚠️ 회전하면 **발급된 게스트 토큰이 전부 무효가 된다**(앱이 401 을 받고 재발급받아야 한다).
#
# 운영: fly secrets set JWT_SECRET=$(openssl rand -hex 32)
JWT_SECRET=jellysafe-dev-secret-change-me-0123456789abcdef
# 액세스 토큰 수명. 서버가 취소할 수 없는 토큰이라 이 값이 곧 유출 시 최대 노출 시간이다.
# 리프레시 토큰이 도입됐으므로 프론트가 재발급 흐름을 붙인 뒤에는 1h 수준으로 줄일 수 있다.
JWT_EXPIRES=12h

# 리프레시 토큰(액세스 토큰 재발급 · 로그아웃).
#
# ⚠️ 이 기능은 `refresh_tokens` 테이블을 쓴다. DB-first 라 코드 배포만으로는 생기지 않는다:
#      mysql -h <host> -u <user> -p <db> < prisma/sql/002-refresh-tokens.sql
#    적용 전에도 앱은 정상 기동한다 — 로그인이 accessToken 만 발급하고(refreshToken=null),
#    /admin/auth/refresh · logout 이 503 을 낸다. 적용하면 그때부터 동작한다.
#
# 유효 일수(1~90, 기본 14). 재로그인 없이 버티는 기간이자 토큰 유출 시 최대 노출 기간이다.
REFRESH_TOKEN_EXPIRES_DAYS=14
# 만료된 토큰 파기 배치(만료 후 7일 유예). 다른 파기 배치와 겹치지 않게 03:15.
REFRESH_TOKEN_PURGE_CRON="0 15 3 * * *"

# 시스템 API 키 — /system/* (위험도 재산출·외부 수집 트리거) 호출용 공유 키.
# 요청 헤더 `x-system-key: <이 값>` 이 일치해야 통과하고, 아니면 401.
#
# ⚠️ 미설정 시 /system/* 은 "통과"가 아니라 "전면 차단(401)" 이다(fail-closed).
#    미설정을 인증 없음으로 해석하면 키를 잊은 채 배포됐을 때 그대로 뚫리기 때문이다.
#    스케줄러 배치는 HTTP 를 타지 않고 유스케이스를 직접 호출하므로, 키가 없어도 배치는 정상 동작한다.
#    (= 키가 없으면 "사람이 수동 트리거하는 것"만 막힌다)
#
# 운영(Fly)에서는 fly.toml [env] 가 아니라 시크릿으로 넣는다:
#   fly secrets set SYSTEM_API_KEY=$(openssl rand -hex 32)
SYSTEM_API_KEY=jellysafe-dev-system-key

# --- Web Push 알림 발송 (VAPID) ---
# 위험 단계 상승(SYS-005)·관리자 발송(ADM-010) 시 관심 해변 구독자의 브라우저로 푸시를 보낸다.
# 미설정이면 발송만 건너뛰고 앱은 정상 동작한다(알림은 DB 에 쌓이고 인앱 알림함은 그대로).
#
# 키 생성: npx web-push generate-vapid-keys
# ⚠️ 공개키를 회전하면 **기존 구독이 전부 무효화된다.** 한 번 정하면 바꾸지 마라.
# ⚠️ 비밀키는 커밋 금지. 운영은 fly secrets 로만 넣는다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@jellysafe.kr   # mailto: 또는 https: 여야 한다

PUSH_TTL_SECONDS=3600   # 푸시 서비스가 알림을 보관할 시간
PUSH_CONCURRENCY=5      # 알림 1건당 동시 발송 구독 수

# 제보 이미지 저장 경로 (기본 ./uploads — 상대 경로는 프로세스 CWD 기준).
# 업로드 컨트롤러의 저장 위치이자, `/uploads/*` 정적 서빙의 루트다(같은 값을 본다).
# 응답 imageUrl 은 `/uploads/파일명` 이며 API 프리픽스(/api)가 붙지 않는다.
#
# ⚠️ 컨테이너 파일시스템에 두면 재배포·재시작마다 사진이 전부 사라진다.
#    운영은 Fly 영구 볼륨을 /data 에 마운트하고 UPLOAD_DIR=/data/uploads 로 지정한다(fly.toml 참고).
UPLOAD_DIR=./uploads

# --- 제보 이미지 저장소 ---
# local : UPLOAD_DIR 볼륨에 저장(기본). **단일 머신 전용** — 볼륨은 머신에 붙는 자원이라
#         머신을 늘리면 사진이 갈라지고(어느 머신이 응답하느냐에 따라 열리거나 404),
#         머신을 옮기면 통째로 사라진다.
# s3    : S3 호환 오브젝트 스토리지. AWS S3 · Fly Tigris · Cloudflare R2 · MinIO 모두 같은 API 다.
#
# ⚠️ local|s3 외의 값이면 기동하지 않는다. 오타가 조용히 로컬 저장으로 떨어지면
#    그 사실은 한참 뒤 "사진이 가끔 안 열린다" 로만 드러난다.
STORAGE_DRIVER=local

# STORAGE_DRIVER=s3 일 때만 쓴다.
#   S3_BUCKET          : 버킷 이름(필수 — 비어 있으면 기동하지 않는다)
#   S3_REGION          : AWS 는 실제 리전, Tigris/R2 는 auto
#   S3_ENDPOINT        : AWS 가 아니면 엔드포인트(예: https://fly.storage.tigris.dev)
#   S3_PUBLIC_BASE_URL : 사진을 읽을 공개 기준 URL(CDN 도메인). **이 값이 DB 에 남는 imageUrl 의
#                        앞부분이라 한 번 정하면 바꾸지 않는다** — 바꾸면 기존 제보 사진이 안 열린다.
#   S3_KEY_PREFIX      : 버킷 안 경로 접두사(기본 reports)
#   S3_FORCE_PATH_STYLE: MinIO 등 가상 호스팅을 못 쓰는 스토리지면 true
#
# 자격증명은 여기 두지 않는다. AWS SDK 기본 체인(AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY,
# 또는 인스턴스 역할)을 그대로 쓴다 — 운영은 `fly secrets set` 으로 넣는다.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_KEY_PREFIX=reports
S3_FORCE_PATH_STYLE=false
# 사전 서명 업로드 URL 유효 시간(초, 30~3600). 짧을수록 안전하고, 너무 짧으면 느린 회선에서 실패한다.
S3_PRESIGN_EXPIRES_SECONDS=300

# CORS 허용 도메인 (콤마 구분). 미지정 시 모든 origin 허용(개발용)
# 운영(fly.toml)에 등록된 값:
#   https://jellysafe-public.vercel.app  (사용자 웹)
#   https://jellysafe-admin.vercel.app   (관리자 콘솔)
# 로컬 개발에서 프론트를 함께 띄운다면 dev 서버 origin 을 추가한다.
# 예: CORS_ORIGIN=https://jellysafe-public.vercel.app,https://jellysafe-admin.vercel.app,http://localhost:5173
CORS_ORIGIN=

# 데이터베이스 (MySQL 8)
# Prisma 와 Kysely 가 동일 URL 을 사용한다.
#
# ⚠️ 커넥션 풀은 **두 개**다. DB 가 보는 접속 수는 두 풀의 합이다:
#      Prisma : 이 URL 의 `?connection_limit=N` (미지정 시 CPU 수 × 2 + 1)
#      Kysely : 아래 DB_POOL_LIMIT (기본 10)
#    관리형 MySQL 은 플랜별 최대 접속 수가 있어, 합이 그 한도를 넘으면 두 풀이 동시에 막힌다.
#    한쪽만 보고 조정하면 안 된다. 기동 로그에 두 값이 모두 찍히므로 합을 눈으로 확인한다.
#    예) 한도 20 인 플랜: DATABASE_URL 에 connection_limit=5, DB_POOL_LIMIT=10 → 합 15.
DATABASE_URL="mysql://jellysafe:jellysafe@localhost:3306/jellysafe"

# DB 커넥션 풀 (Kysely mysql2 pool)
DB_POOL_LIMIT=10

# 관리형 MySQL(Aiven/PlanetScale 등) 배포 시 SSL 필수 → DB_SSL=true
# 로컬 개발은 false. Prisma 는 DATABASE_URL 쿼리 파라미터로 SSL 을 처리한다.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# 위험도 룰 버전 (활성 룰셋 지정). v3 = 인근 출현을 밀도별로 채점(docs/risk-rules-v3.md).
# 롤백: v2(건수 무구분 +40) / v1(초안). 세 버전이 DB 에 나란히 있다.
#
# ⚠️ v1|v2|v3 외의 값이면 **기동하지 않는다**(env 검증). 예전에는 오타(`V3`, `v33`)가 통과했고,
#    DB 에 그 버전의 룰이 없으니 엔진이 코드 상수 폴백(= v1 점수표)으로 조용히 되돌아갔다.
#    버전은 맞지만 DB 에 룰이 없으면 위험도 산출이 422 로 멈춘다(틀린 점수를 내지 않는다).
RISK_RULE_VERSION=v3

# AI 판별 (SYS-004). MVP 는 Mock. 실제 모델 연동 시 엔드포인트/키 채움
VISION_AI_MODE=mock
VISION_AI_ENDPOINT=
VISION_AI_API_KEY=

# 외부 데이터 수집 (SYS-001). 발급받은 인증키를 넣는다.
# 개발/CI 는 비워둬도 mock 폴백으로 앱이 동작한다(아래 MOCK_COLLECTOR_FALLBACK 참고).
# ⚠️ 운영(NODE_ENV=production)은 폴백이 꺼져 있으므로 **키가 없으면 수집이 실패로 기록된다.**
#   KMA_API_KEY  : 기상청 API 허브(apihub.kma.go.kr) 해양기상종합관측.
#                  제주 21개 지점의 수온/파고/풍향·풍속을 제공한다 — 해변별 위험도의 주 데이터원.
#   KHOA_API_KEY : 국립해양조사원 해양관측부이(공공데이터포털 Encoding 키).
#                  유향·유속·염분을 주는 유일한 소스이나 제주에는 중문(TW_0075) 1곳뿐이다.
#   NIFS_API_KEY : 국립수산과학원 해파리 출현/속보(공공데이터포털 Encoding 키).
KMA_API_KEY=
KHOA_API_KEY=
NIFS_API_KEY=

# 실 수집기가 실패하거나 인증키가 없을 때 mock 데이터로 대체할지.
# 미지정 시 NODE_ENV=production 이면 false, 그 외에는 true 다.
#
# ⚠️ 운영에서 켜지 마라. mock 은 수온·파고는 물론 **독성/고밀도 해파리 출현까지** 만들어 내며,
#    그 값이 실데이터와 구분 표시 없이 저장돼 위험도 산출에 그대로 들어간다.
#    게다가 mock 이 늘 결과를 채워 주면 "수집기가 0건을 반환한다"로 조용한 고장을 잡는
#    sync-health 판정이 무력화돼, API 가 몇 주 죽어 있어도 대시보드가 정상으로 보인다.
#    폴백을 끄면 실패는 failed 로 기록되고, 결측은 위험도 신뢰도 하향으로 정직하게 드러난다.
MOCK_COLLECTOR_FALLBACK=true

# 배치 스케줄 (cron). 비활성화하려면 SCHEDULER_ENABLED=false
SCHEDULER_ENABLED=true
# 외부 데이터 수집 → 관측소 매핑 → 위험도 재산출까지 이어서 실행한다(30분 주기).
# 위험도 산출은 신선한 관측치로 해야 하므로 이 배치가 재산출까지 책임진다.
OBSERVATION_SYNC_CRON="0 */30 * * * *"

# 위험도 재산출 "전용" 크론. 기본 off — 위 관측 배치가 이미 재산출한다.
# 켜두면 같은 계산이 중복 실행되어 risk_scores/risk_factors 만 더 쌓인다.
# 관측 수집을 끄고 위험도만 따로 돌려야 할 때만 크론식을 지정한다.
RISK_RECALC_CRON=off

# 위험도 산출 이력 파기. 산출할 때마다 새 행이 쌓이고 과거 행은 is_latest 만 해제된 채 남는다.
# 조회에 쓰이는 건 최신 행뿐이므로, 보관 일수가 지난 이력은 새벽에 하루 1회 정리한다.
# 0 으로 두면 파기하지 않는다(무한히 쌓인다).
RISK_HISTORY_RETENTION_DAYS=90
RISK_HISTORY_PURGE_CRON="0 40 3 * * *"

DAILY_REPORT_CRON="0 10 0 * * *"

# --- 보관정책 (파기 배치) ---
# 관측치는 관측소 15곳 × 30분마다 쌓여 하루 700행이 넘는다. 위험도 산출이 실제로 보는 건
# 최근 7일(7일 평균 수온)까지라 그보다 넉넉히 남기고 정리한다. 7일 미만을 넣어도 7로 클램프한다.
# 관측소별 "가장 최근 1행"은 보관 기간과 무관하게 남긴다 — 이걸 지우면 고장난 관측소에 매핑된
# 해변의 수온/파고가 통째로 사라져 신뢰도가 떨어진다.
OBSERVATION_RETENTION_DAYS=30
OBSERVATION_PURGE_CRON="0 20 3 * * *"

# 해파리 출현 기록. 관측 파기 배치가 함께 정리한다(OBSERVATION_PURGE_CRON).
# ⚠️ PAST_OCCURRENCE 룰이 **과거 5년**의 같은 시기를 세므로 그보다 짧게 잡으면
#    그 룰이 점수표에 남아 있으면서 실제로는 절대 발화하지 않는 상태가 된다.
#    5년 미만을 넣어도 5로 클램프한다. 연 수백 행 규모라 넉넉히 남겨도 부담이 없다.
OCCURRENCE_RETENTION_YEARS=6

# 알림 발송 이력. 재발송 억제(cooldown)가 살아있는 행은 보관 기간과 무관하게 남긴다.
NOTIFICATION_RETENTION_DAYS=90
NOTIFICATION_PURGE_CRON="0 50 3 * * *"

# 제보 사진/위치 파기(PRIV-003). purge_scheduled_at 이 지난 제보를 정리한다.
# DB 마스킹 + **실제 업로드 파일 삭제** + 만료된 동의 기록 파기를 한 배치에서 순서대로 한다.
REPORT_PURGE_CRON="0 30 3 * * *"

# 제보 사진·위치 보관 일수(PRIV-003). 접수 시점 + 이 기간이 파기 예정 시각이 된다.
# ⚠️ 접수할 때 행에 박아 넣는 값이라, 바꿔도 **이미 접수된 제보의 파기 시점은 바뀌지 않는다**
#    (사용자가 동의한 그 시점의 정책이 그대로 적용된다). 1 미만이면 기본값으로 되돌린다.
REPORT_RETENTION_DAYS=90

# 동의 기록(PRIV-001) 보관 일수. 제보 데이터보다 **길게** 두는 것이 의도다 —
# 제보 사진·위치는 목적을 다하면 지워야 하지만, 동의 기록은 그 수집이 적법했음을 사후에
# 증명하는 자료라 먼저 사라지면 안 된다. 다만 동의 기록도 개인정보라 무기한 보관하지 않는다.
# 만료된 동의는 연결된 제보가 이미 파기된 경우에만 지운다(살아있는 제보의 근거는 남긴다).
CONSENT_RETENTION_DAYS=365

# 부팅 시 '고아 산출'로 볼 경과 시간(분). 배포/OOM 으로 프로세스가 죽으면 risk_calculations 가
# running 인 채 남는데, 그걸 다음 부팅에서 실패로 확정한다. 0 이면 정리하지 않는다.
RISK_CALCULATION_STALE_MINUTES=30

# --- 수집 이상 감지 ---
# 수집이 조용히 죽는 것을 잡는다. 특히 국립수산과학원 수집기는 주간보고 PDF 를 파싱하는데,
# PDF 양식이 바뀌면 예외 없이 0건을 반환하고 수집은 "성공"으로 기록된다. 아무도 모르는 사이
# 해파리 데이터만 말라가고 위험도가 계속 낮게 나온다.
#
# stale  : lastSyncedAt 이 (수집주기 × 배수)를 넘도록 갱신 안 됨
# zero_yield : 수집은 되는데 결과가 계속 0건
#   해파리는 유예 14일(= 주간보고 2회분). 실제로 출현이 없는 주가 있을 수 있어 한 주는 조용히 넘긴다.
#   해양/기상 부이는 매번 값이 와야 정상이므로 유예 6시간.
#   비수기처럼 애초에 보고가 안 나오는 기간에는 0 으로 꺼둘 수 있다.
OBSERVATION_SOURCE_STALE_MULTIPLIER=3
OBSERVATION_SOURCE_DEFAULT_INTERVAL_MINUTES=30
OBSERVATION_JELLYFISH_ZERO_YIELD_DAYS=14
OBSERVATION_MARINE_ZERO_YIELD_HOURS=6
