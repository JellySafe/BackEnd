model OperationAction {
  id               BigInt   @id @default(autoincrement())
  beachId          BigInt   @map("beach_id")
  riskScoreId      BigInt?  @map("risk_score_id")
  recommendationId BigInt?  @map("recommendation_id")
  actionType       String?  @map("action_type") @db.VarChar(50)
  operationStatus  String   @map("operation_status") @db.VarChar(30) // normal/monitoring_up/entry_caution/lifeguard_added/broadcast/zone_control_review/entry_ban/resumed
  memo             String?  @db.VarChar(500)
  createdBy        BigInt   @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(0)

  beach          Beach                @relation(fields: [beachId], references: [id], onDelete: Restrict)
  riskScore      RiskScore?           @relation(fields: [riskScoreId], references: [id], onDelete: SetNull)
  recommendation RiskRecommendation?  @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  creator        User                 @relation(fields: [createdBy], references: [id], onDelete: Restrict)
