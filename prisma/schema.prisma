// =====================================================================================
// 9. 2차 확장 (EX-001~004) — MVP 범위 밖. 스키마 확장 지점만 정의.
// =====================================================================================

model NotificationConsent {
  id                   BigInt    @id @default(autoincrement())
  userId               BigInt?   @map("user_id")
  userToken            String?   @map("user_token") @db.VarChar(64)
  channel              String    @db.VarChar(20) // push/sms/email
  agreed               Boolean   @default(false)
  phoneNumber          String?   @map("phone_number") @db.VarChar(30)
  deviceToken          String?   @map("device_token") @db.VarChar(255)
  /// Web Push 구독 정보(endpoint/p256dh/auth). 브라우저가 발급하며 endpoint 만 300자를 넘어 deviceToken 에 담기지 않는다.
  pushSubscriptionJson Json?     @map("push_subscription_json")
  agreedAt             DateTime? @map("agreed_at") @db.DateTime(0)
  revokedAt            DateTime? @map("revoked_at") @db.DateTime(0)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_consents")
}

model NotificationDispatch {
  id             BigInt    @id @default(autoincrement())
  notificationId BigInt    @map("notification_id")
  channel        String    @db.VarChar(20) // push/sms/email
  provider       String?   @db.VarChar(50)
  recipient      String    @db.VarChar(255)
  dispatchStatus String    @default("pending") @map("dispatch_status") @db.VarChar(20) // pending/sent/failed/rejected
  failedReason   String?   @map("failed_reason") @db.VarChar(500)
  retryCount     Int       @default(0) @map("retry_count") @db.SmallInt
  costAmount     Decimal?  @map("cost_amount") @db.Decimal(10, 2)
  sentAt         DateTime? @map("sent_at") @db.DateTime(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([dispatchStatus, createdAt], name: "ix_notification_dispatches_status")
  @@map("notification_dispatches")
}

model Partner {
  id            BigInt   @id @default(autoincrement())
  partnerCode   String   @unique @map("partner_code") @db.VarChar(50)
  name          String   @db.VarChar(150)
  businessNo    String?  @map("business_no") @db.VarChar(30)
  contactName   String?  @map("contact_name") @db.VarChar(100)
  contactEmail  String?  @map("contact_email") @db.VarChar(255)
  planCode      String?  @map("plan_code") @db.VarChar(30)
  partnerStatus String   @default("active") @map("partner_status") @db.VarChar(20) // active/suspended/terminated
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)

  apiKeys  PartnerApiKey[]
  callLogs PartnerApiCallLog[]

  @@map("partners")
}

model PartnerApiKey {
  id              BigInt    @id @default(autoincrement())
  partnerId       BigInt    @map("partner_id")
  keyPrefix       String    @unique @map("key_prefix") @db.VarChar(16)
  apiKeyHash      String    @map("api_key_hash") @db.VarChar(255)
  scopesJson      Json?     @map("scopes_json")
  rateLimitPerMin Int?      @map("rate_limit_per_min")
  expiresAt       DateTime? @map("expires_at") @db.DateTime(0)
  revokedAt       DateTime? @map("revoked_at") @db.DateTime(0)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  partner  Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  callLogs PartnerApiCallLog[]

  @@map("partner_api_keys")
}

model PartnerApiCallLog {
  id             BigInt   @id @default(autoincrement())
  partnerId      BigInt   @map("partner_id")
  apiKeyId       BigInt?  @map("api_key_id")
  endpoint       String   @db.VarChar(255)
  httpMethod     String   @map("http_method") @db.VarChar(10)
  statusCode     Int      @map("status_code") @db.SmallInt
  responseTimeMs Int?     @map("response_time_ms")
  isBillable     Boolean  @default(true) @map("is_billable")
  calledAt       DateTime @default(now()) @map("called_at") @db.DateTime(0)

  partner Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  apiKey  PartnerApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([partnerId, calledAt], name: "ix_partner_api_call_logs_partner_time")
  @@map("partner_api_call_logs")
}

model MlModel {
  id              BigInt    @id @default(autoincrement())
  modelName       String    @map("model_name") @db.VarChar(100)
  version         String    @db.VarChar(30)
  algorithm       String?   @db.VarChar(50)
  modelPurpose    String    @map("model_purpose") @db.VarChar(30) // risk_prediction/vision
  hyperparamsJson Json?     @map("hyperparams_json")
  metricsJson     Json?     @map("metrics_json")
  artifactUri     String?   @map("artifact_uri") @db.VarChar(500)
  modelStatus     String    @default("training") @map("model_status") @db.VarChar(20) // training/staging/active/archived
  trainedAt       DateTime? @map("trained_at") @db.DateTime(0)
  activatedAt     DateTime? @map("activated_at") @db.DateTime(0)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  riskScores RiskScore[]

  @@unique([modelName, version], name: "uk_ml_models_name_version")
  @@map("ml_models")
}

model Subscription {
  id                 BigInt    @id @default(autoincrement())
  userId             BigInt    @map("user_id")
  subscriberType     String    @map("subscriber_type") @db.VarChar(20) // fisherman/aquafarm
  planCode           String    @map("plan_code") @db.VarChar(30)
  subscriptionStatus String    @default("pending") @map("subscription_status") @db.VarChar(20) // pending/active/paused/canceled/expired
  priceAmount        Decimal?  @map("price_amount") @db.Decimal(10, 2)
  paymentStatus      String?   @map("payment_status") @db.VarChar(20) // unpaid/paid/refunded
  startedAt          DateTime? @map("started_at") @db.DateTime(0)
  expiresAt          DateTime? @map("expires_at") @db.DateTime(0)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  areas SubscriptionArea[]

  @@index([userId, subscriptionStatus], name: "ix_subscriptions_user_status")
  @@map("subscriptions")
}

model SubscriptionArea {
  id             BigInt   @id @default(autoincrement())
  subscriptionId BigInt   @map("subscription_id")
  beachId        BigInt?  @map("beach_id")
  label          String?  @db.VarChar(100)
  centerLat      Decimal? @map("center_lat") @db.Decimal(10, 7)
  centerLng      Decimal? @map("center_lng") @db.Decimal(10, 7)
  radiusKm       Decimal? @map("radius_km") @db.Decimal(6, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(0)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  beach        Beach?       @relation(fields: [beachId], references: [id], onDelete: Cascade)

  @@map("subscription_areas")
}

// =====================================================================================
//  정답 데이터 (groundtruth) — 예측이 맞았는지 재는 데 쓴다.
//  DDL 은 prisma/sql/004-groundtruth.sql (DB-first 라 migrate 를 쓰지 않는다).
// =====================================================================================

/// 현장 관측 기록. **부재(jellyfishPresent=false)도 기록한다** — 그게 없으면 오경보를 셀 수 없다.
model FieldObservation {
  id               BigInt   @id @default(autoincrement())
  beachId          BigInt   @map("beach_id")
  observedAt       DateTime @map("observed_at") @db.DateTime(0)
  source           String   @db.VarChar(20) // lifeguard/official/partner
  observerId       BigInt?  @map("observer_id")
  observerName     String?  @map("observer_name") @db.VarChar(50)
  jellyfishPresent Boolean  @map("jellyfish_present")
  densityLevel     String?  @map("density_level") @db.VarChar(20) // low/medium/high
  speciesId        BigInt?  @map("species_id")
  estimatedCount   Int?     @map("estimated_count")
  note             String?  @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(0)

  beach    Beach             @relation(fields: [beachId], references: [id], onDelete: Cascade)
  observer User?             @relation(fields: [observerId], references: [id], onDelete: SetNull)
  species  JellyfishSpecies? @relation(fields: [speciesId], references: [id], onDelete: SetNull)

  @@index([beachId, observedAt], name: "ix_field_observations_beach_time")
  @@map("field_observations")
}

/// 쏘임 사고 기록. 가장 강한 정답이다. 환자 신원은 **컬럼 자체가 없다**.
model StingIncident {
  id           BigInt   @id @default(autoincrement())
  beachId      BigInt   @map("beach_id")
  occurredAt   DateTime @map("occurred_at") @db.DateTime(0)
  source       String   @db.VarChar(20) // emergency_call/coast_guard/lifeguard/hospital/self_report
  severity     String   @db.VarChar(20) // mild/moderate/severe/fatal
  patientCount Int      @map("patient_count")
  speciesId    BigInt?  @map("species_id")
  /// 외부 기관 사건 식별자. 같은 사고가 두 경로로 들어올 때 묶는 열쇠(자동 병합은 하지 않는다).
  externalRef  String?  @map("external_ref") @db.VarChar(100)
  note         String?  @db.VarChar(500)
  reportedBy   BigInt?  @map("reported_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)

  beach    Beach             @relation(fields: [beachId], references: [id], onDelete: Cascade)
  species  JellyfishSpecies? @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  reporter User?             @relation(fields: [reportedBy], references: [id], onDelete: SetNull)

  @@index([beachId, occurredAt], name: "ix_sting_incidents_beach_time")
  @@index([externalRef], name: "ix_sting_incidents_external_ref")
  @@map("sting_incidents")
}

/// 예측 대조 결과(해변 × 하루). 같은 날을 다시 평가하면 덮어쓴다(UNIQUE).
model PredictionEvaluation {
  id             BigInt   @id @default(autoincrement())
  beachId        BigInt   @map("beach_id")
  /// KST 기준 날짜.
  targetDate     DateTime @map("target_date") @db.Date
  predictedLevel String   @map("predicted_level") @db.VarChar(20)
  predictedScore Int      @map("predicted_score") @db.SmallInt
  observed       Boolean
  actualDensity  String?  @map("actual_density") @db.VarChar(20)
  incidentCount  Int      @default(0) @map("incident_count")
  outcome        String   @db.VarChar(20) // hit/miss/false_alarm/correct_negative
  /// 판정에 쓴 경보 임계선. 정책이 바뀌면 과거 지표와 비교할 수 없으므로 행에 박아 둔다.
  alertThreshold String   @map("alert_threshold") @db.VarChar(20)
  ruleVersion    String   @map("rule_version") @db.VarChar(20)
  evaluatedAt    DateTime @default(now()) @map("evaluated_at") @db.DateTime(0)

  beach Beach @relation(fields: [beachId], references: [id], onDelete: Cascade)

  @@unique([beachId, targetDate], name: "uk_prediction_evaluations_beach_date")
  @@index([targetDate, outcome], name: "ix_prediction_evaluations_date_outcome")
  @@map("prediction_evaluations")
}
