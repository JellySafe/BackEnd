  @@index([beachId, createdAt], name: "ix_operation_actions_beach_time")
  @@index([createdBy, createdAt], name: "ix_operation_actions_creator")
  @@map("operation_actions")
}

model OperationStatusLog {
  id                BigInt   @id @default(autoincrement())
  beachId           BigInt   @map("beach_id")
  operationActionId BigInt?  @map("operation_action_id")
  previousStatus    String?  @map("previous_status") @db.VarChar(30)
  newStatus         String   @map("new_status") @db.VarChar(30)
  reason            String?  @db.VarChar(500)
  changedBy         BigInt   @map("changed_by")
  changedAt         DateTime @default(now()) @map("changed_at") @db.DateTime(0)

  beach           Beach            @relation(fields: [beachId], references: [id], onDelete: Restrict)
  operationAction OperationAction? @relation(fields: [operationActionId], references: [id], onDelete: SetNull)
  changer         User             @relation(fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([beachId, changedAt], name: "ix_operation_status_logs_beach_time")
  @@map("operation_status_logs")
}

