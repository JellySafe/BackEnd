// 6. 알림 (SYS-005 / ADM-010)
// =====================================================================================

model NotificationTemplate {
  id           BigInt   @id @default(autoincrement())
  templateCode String   @unique @map("template_code") @db.VarChar(50)
  targetType   String   @map("target_type") @db.VarChar(20) // admin/operator/public
  riskLevel    String?  @map("risk_level") @db.VarChar(20)
  eventType    String?  @map("event_type") @db.VarChar(30) // level_up/toxic_report/sting_report
  title        String?  @db.VarChar(200)
  body         String   @db.Text
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  notifications Notification[]

  @@map("notification_templates")
}

model Notification {
  id              BigInt    @id @default(autoincrement())
  targetType      String    @map("target_type") @db.VarChar(20) // admin/operator/public
  targetUserId    BigInt?   @map("target_user_id")
  targetUserToken String?   @map("target_user_token") @db.VarChar(64)
  beachId         BigInt    @map("beach_id")
  riskLevel       String?   @map("risk_level") @db.VarChar(20)
  eventType       String    @map("event_type") @db.VarChar(30) // level_up/toxic_report/sting_report
  templateId      BigInt?   @map("template_id")
  title           String?   @db.VarChar(200) // ADM-010 수동 발송 제목(치환 완료본)
  message         String    @db.Text
  dedupKey        String?   @unique @map("dedup_key") @db.VarChar(150)
  cooldownUntil   DateTime? @map("cooldown_until") @db.DateTime(0)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  readAt          DateTime? @map("read_at") @db.DateTime(0)

  targetUser User?                  @relation(fields: [targetUserId], references: [id], onDelete: Cascade)
  beach      Beach                  @relation(fields: [beachId], references: [id], onDelete: Cascade)
  template   NotificationTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  dispatches NotificationDispatch[]

  @@index([targetUserId, readAt, createdAt], name: "ix_notifications_user_read")
  @@index([beachId, createdAt], name: "ix_notifications_beach_time")
  @@index([targetUserToken, readAt, createdAt], name: "ix_notifications_token_read")
  @@map("notifications")
}

