// =====================================================================================
//  JellySafe - Prisma schema
//  Source of truth : db/jellysafe_schema.sql  (MySQL 8)
//
//  방침
//   - DB-first: 실제 스키마는 DDL 파일이 원본이다. 이 파일은 그 위에 매핑한다.
//     운영 DB 가 준비되면 `prisma db pull` 로 이 파일을 재생성/대조할 수 있다.
//   - 상태값 컬럼은 Prisma enum 이 아니라 String 으로 둔다.
//     DDL 이 VARCHAR + CHECK + COLLATE utf8mb4_bin 으로 소문자 값 목록을 강제하므로,
//     Prisma enum(=MySQL ENUM) 을 쓰면 migrate 시 DDL 과 충돌한다.
//     값 계약(소문자)은 각 컨텍스트 domain 계층의 TS union 타입이 보증한다.
//   - PK 는 DDL 대로 BIGINT → Prisma BigInt. 응답 직렬화는 main.ts 의 BigInt.toJSON 패치로 처리.
// =====================================================================================

generator client {
  provider = "prisma-client-js"
}

// Kysely 테이블 타입을 Prisma 스키마에서 생성한다(prisma-kysely).
// 복잡 조회 어댑터가 이 타입을 import 해 타입세이프 SQL 을 작성한다.
generator kysely {
  provider     = "prisma-kysely"
  output       = "../src/shared/persistence/kysely"
  fileName     = "database.types.ts"
  enumFileName = "database.enums.ts"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =====================================================================================
// 1. 마스터 / 공통
// =====================================================================================

model User {
  id            BigInt    @id @default(autoincrement())
  role          String    @default("public") @db.VarChar(20) // public/operator/admin
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  name          String    @db.VarChar(100)
  organization  String?   @db.VarChar(150)
  managedRegion String?   @map("managed_region") @db.VarChar(50)
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at") @db.DateTime(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  consentLogs         ConsentLog[]
  reportedJellyfish   JellyfishReport[]     @relation("ReportReporter")
  reportReviews       ReportReview[]
  updatedRuleConfigs  RiskRuleConfig[]
  triggeredCalcs      RiskCalculation[]
  operationActions    OperationAction[]
  operationStatusLogs OperationStatusLog[]
  dailyReports        DailyReport[]
  favoriteBeaches     FavoriteBeach[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  notificationConsent NotificationConsent[]
  subscriptions       Subscription[]
  refreshTokens       RefreshToken[]

  fieldObservations FieldObservation[]
  stingIncidents    StingIncident[]
  @@map("users")
}

/// 리프레시 토큰 (AUTH-001 재발급·로그아웃).
/// 원문은 저장하지 않는다 — token_hash 는 SHA-256(토큰) hex 64자다.
/// 운영 DB 에는 prisma/sql/002-refresh-tokens.sql 을 적용해야 이 모델이 실제 테이블과 맞는다.
model RefreshToken {
  id            BigInt    @id @default(autoincrement())
  userId        BigInt    @map("user_id")
  tokenHash     String    @unique(map: "uk_refresh_tokens_hash") @map("token_hash") @db.Char(64)
  familyId      String    @map("family_id") @db.Char(32)
  issuedAt      DateTime  @map("issued_at") @db.DateTime(0)
  expiresAt     DateTime  @map("expires_at") @db.DateTime(0)
  usedAt        DateTime? @map("used_at") @db.DateTime(0)
  revokedAt     DateTime? @map("revoked_at") @db.DateTime(0)
  revokedReason String?   @map("revoked_reason") @db.VarChar(30)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], name: "ix_refresh_tokens_user")
  @@index([familyId], name: "ix_refresh_tokens_family")
  @@index([expiresAt], name: "ix_refresh_tokens_expires")
  @@map("refresh_tokens")
}

model Beach {
  id                 BigInt   @id @default(autoincrement())
  name               String   @unique @db.VarChar(100)
  region             String   @db.VarChar(50)
  lat                Decimal  @db.Decimal(10, 7)
  lng                Decimal  @db.Decimal(10, 7)
  facingDirection    Int?     @map("facing_direction") @db.SmallInt
  priority           Int      @default(99) @db.SmallInt
  /// 해변 대표 사진 URL. 미등록이면 null → 프론트가 placeholder 로 대체한다.
  imageUrl           String?  @map("image_url") @db.VarChar(500)
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  observationMappings ObservationMapping[]
  weatherForecasts    WeatherForecast[]
  jellyfishReports    JellyfishReport[]
  riskScores          RiskScore[]
  operationActions    OperationAction[]
  operationStatusLogs OperationStatusLog[]
  notifications       Notification[]
  dailyReports        DailyReport[]
  favoriteBeaches     FavoriteBeach[]
  subscriptionAreas   SubscriptionArea[]

  fieldObservations FieldObservation[]
  stingIncidents    StingIncident[]
  predictionEvaluations PredictionEvaluation[]
  @@map("beaches")
}

model StaticGuide {
  id           BigInt   @id @default(autoincrement())
  guideCode    String   @unique @map("guide_code") @db.VarChar(50)
  targetType   String   @map("target_type") @db.VarChar(20) // public/operator/admin/common
  riskLevel    String?  @map("risk_level") @db.VarChar(20) // safe/caution/danger/severe
  title        String?  @db.VarChar(200)
  body         String   @db.Text
  displayOrder Int      @default(0) @map("display_order") @db.SmallInt
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@map("static_guides")
}

model RiskRecommendation {
  id           BigInt   @id @default(autoincrement())
  actionCode   String   @unique @map("action_code") @db.VarChar(50)
  riskLevel    String   @map("risk_level") @db.VarChar(20) // caution/danger/severe
  title        String   @db.VarChar(200)
  description  String?  @db.Text
  displayOrder Int      @default(0) @map("display_order") @db.SmallInt
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  operationActions OperationAction[]

  @@map("risk_recommendations")
}

/// 해파리 종 정보(도감). 출현 종을 사진·특징·독성으로 설명하는 참조 데이터다.
///
/// jellyfish_occurrences 와 **FK 로 묶지 않는다**: occurrences.species 는 국립수산과학원
/// 주간보고 PDF 원문 표기라, 도감에 없는 종이 등장해도 수집 배치가 죽으면 안 된다.
/// 연결은 이름 정규화 매칭(species-name.ts)으로 한다 — 주간보고 '유령해파리류' ↔ 도감 '유령해파리'.
///
/// 이미지는 원본(국립수산과학원) URL 을 링크만 한다. 복제·재호스팅하지 않고 출처를 함께 노출한다.
/// ⛔ 종별 응급처치는 넣지 않는다(현행 통합 지침 static_guides.FIRST_AID 와 충돌). stingSymptom 은 '증상'이다.
model JellyfishSpecies {
  id               BigInt   @id @default(autoincrement())
  koreanName       String   @unique @map("korean_name") @db.VarChar(100)
  scientificName   String?  @map("scientific_name") @db.VarChar(100)
  /// strong(강독성)/mild(약독성)/harmless(무해성). 기관 미발표 종은 null — 추정 금지.
  toxicity         String?  @db.VarChar(20)
  features         String?  @db.VarChar(1000)
  appearanceSeason String?  @map("appearance_season") @db.VarChar(300)
  /// 쏘였을 때의 증상(원문). 처치법이 아니다.
  stingSymptom     String?  @map("sting_symptom") @db.VarChar(300)
  imageUrl         String?  @map("image_url") @db.VarChar(500)
  /// 이미지 출처 표기. 화면에 반드시 함께 노출한다(공공누리 필수 조건).
  imageSource      String?  @map("image_source") @db.VarChar(200)
  imageSourceUrl   String?  @map("image_source_url") @db.VarChar(500)
  displayOrder     Int      @default(0) @map("display_order") @db.SmallInt
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([active, displayOrder], name: "ix_jellyfish_species_active")
  fieldObservations FieldObservation[]
  stingIncidents    StingIncident[]
  @@map("jellyfish_species")
}

// =====================================================================================
// 2. 데이터 수집 (SYS-001 / SYS-002)
// =====================================================================================

model DataSource {
  id                  BigInt    @id @default(autoincrement())
  sourceCode          String    @unique @map("source_code") @db.VarChar(50)
  name                String    @db.VarChar(150)
  provider            String?   @db.VarChar(100)
  sourceType          String    @map("source_type") @db.VarChar(20) // jellyfish/marine/weather/beach
  endpointUrl         String?   @map("endpoint_url") @db.VarChar(500)
  isSample            Boolean   @default(false) @map("is_sample")
  syncIntervalMinutes Int?      @map("sync_interval_minutes")
  lastSyncedAt        DateTime? @map("last_synced_at") @db.DateTime(0)
  lastSyncStatus      String?   @map("last_sync_status") @db.VarChar(20) // success/partial/failed
  lastSyncMessage     String?   @map("last_sync_message") @db.VarChar(500)
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  stations    ObservationStation[]
  occurrences JellyfishOccurrence[]
  forecasts   WeatherForecast[]

  @@map("data_sources")
}

model ObservationStation {
  id          BigInt   @id @default(autoincrement())
  sourceId    BigInt   @map("source_id")
  stationCode String   @map("station_code") @db.VarChar(50)
  name        String   @db.VarChar(150)
  stationType String   @map("station_type") @db.VarChar(20) // marine/weather
  lat         Decimal  @db.Decimal(10, 7)
  lng         Decimal  @db.Decimal(10, 7)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)

  source       DataSource           @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  observations Observation[]
  mappings     ObservationMapping[]

  @@unique([sourceId, stationCode], name: "uk_observation_stations_code")
  @@map("observation_stations")
}

model Observation {
  id               BigInt   @id @default(autoincrement())
  stationId        BigInt   @map("station_id")
  observedAt       DateTime @map("observed_at") @db.DateTime(0)
  waterTemp        Decimal? @map("water_temp") @db.Decimal(4, 1)
  salinity         Decimal? @db.Decimal(5, 2)
  waveHeight       Decimal? @map("wave_height") @db.Decimal(4, 2)
  currentDirection Int?     @map("current_direction") @db.SmallInt
  currentSpeed     Decimal? @map("current_speed") @db.Decimal(5, 2)
  windDirection    Int?     @map("wind_direction") @db.SmallInt
  windSpeed        Decimal? @map("wind_speed") @db.Decimal(5, 2)
  airTemp          Decimal? @map("air_temp") @db.Decimal(4, 1)
  precipitation    Decimal? @db.Decimal(6, 2)
  qualityFlag      String   @default("normal") @map("quality_flag") @db.VarChar(20) // normal/missing/outlier
  collectedAt      DateTime @default(now()) @map("collected_at") @db.DateTime(0)

  station ObservationStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationId, observedAt], name: "uk_observations_station_time")
  // ix_observations_station_time(station_id, observed_at) 은 위 UNIQUE 와 컬럼·순서가 같아
  // 조회에 보태는 것 없이 쓰기 비용만 늘리므로 제거했다(prisma/sql/001-index-cleanup.sql).
  // 운영 DB 에 그 스크립트를 적용해야 `db pull` 결과와 이 파일이 일치한다.
  @@map("observations")
}

/// 해변별 기상 예보 (RISK-006 24h/72h 예측 입력).
/// 관측(observations)은 "지금 어떤가", 예보는 "앞으로 어떨 것인가" 다. 성격이 달라 테이블을 나눈다.
/// 예보는 관측소가 아니라 격자 단위로 발표되므로 해변에 직접 붙인다.
/// 같은 대상 시각이 3시간마다 다시 발표되므로 UNIQUE(beachId, targetAt) 로 최신 발표만 남긴다.
model WeatherForecast {
  id            BigInt   @id @default(autoincrement())
  beachId       BigInt   @map("beach_id")
  sourceId      BigInt?  @map("source_id")
  baseAt        DateTime @map("base_at") @db.DateTime(0)
  targetAt      DateTime @map("target_at") @db.DateTime(0)
  waveHeight    Decimal? @map("wave_height") @db.Decimal(4, 2)
  windDirection Int?     @map("wind_direction") @db.SmallInt
  windSpeed     Decimal? @map("wind_speed") @db.Decimal(5, 2)
  airTemp       Decimal? @map("air_temp") @db.Decimal(4, 1)
  precipitation Decimal? @map("precipitation") @db.Decimal(6, 2)
  skyCode       String?  @map("sky_code") @db.VarChar(20)
  collectedAt   DateTime @default(now()) @map("collected_at") @db.DateTime(0)

  beach  Beach       @relation(fields: [beachId], references: [id], onDelete: Cascade)
  source DataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([beachId, targetAt], name: "uk_weather_forecasts_target")
  @@index([beachId, targetAt], name: "ix_weather_forecasts_beach_target")
  @@map("weather_forecasts")
}

model ObservationMapping {
  id          BigInt   @id @default(autoincrement())
  beachId     BigInt   @map("beach_id")
  stationId   BigInt   @map("station_id")
  stationType String   @map("station_type") @db.VarChar(20) // marine/weather
  distanceKm  Decimal? @map("distance_km") @db.Decimal(7, 3)
  isPrimary   Boolean? @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)

  beach   Beach              @relation(fields: [beachId], references: [id], onDelete: Cascade)
  station ObservationStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([beachId, stationId], name: "uk_observation_mappings_pair")
  @@unique([beachId, stationType, isPrimary], name: "uk_observation_mappings_primary")
  @@map("observation_mappings")
}

model JellyfishOccurrence {
  id           BigInt   @id @default(autoincrement())
  sourceId     BigInt   @map("source_id")
  externalId   String?  @map("external_id") @db.VarChar(100)
  occurredAt   DateTime @map("occurred_at") @db.DateTime(0)
  region       String?  @db.VarChar(50)
  lat          Decimal? @db.Decimal(10, 7)
  lng          Decimal? @db.Decimal(10, 7)
  species      String?  @db.VarChar(100)
  isToxic      Boolean? @map("is_toxic")
  densityLevel String?  @map("density_level") @db.VarChar(20) // low/medium/high
  alertLevel   String?  @map("alert_level") @db.VarChar(20) // none/attention/caution/warning
  description  String?  @db.VarChar(500)
  collectedAt  DateTime @default(now()) @map("collected_at") @db.DateTime(0)

  source DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, externalId], name: "uk_jellyfish_occurrences_ext")
  @@index([occurredAt, region], name: "ix_jellyfish_occurrences_time_region")
  @@index([lat, lng], name: "ix_jellyfish_occurrences_geo")
  @@map("jellyfish_occurrences")
}

// =====================================================================================
// 3. 제보 (USR-004/005, ADM-008/009)
// =====================================================================================

model ConsentLog {
  id            BigInt    @id @default(autoincrement())
  userId        BigInt?   @map("user_id")
  userToken     String?   @map("user_token") @db.VarChar(64)
  consentType   String    @map("consent_type") @db.VarChar(30) // privacy/location/image/marketing
  agreed        Boolean
  policyVersion String    @map("policy_version") @db.VarChar(20)
  agreedAt      DateTime  @default(now()) @map("agreed_at") @db.DateTime(0)
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  expiresAt     DateTime? @map("expires_at") @db.DateTime(0)

  user           User?           @relation(fields: [userId], references: [id], onDelete: Restrict)
  reportConsents ReportConsent[]

  @@index([userToken, agreedAt], name: "ix_consent_logs_token")
  @@map("consent_logs")
}

model JellyfishReport {
  id                  BigInt    @id @default(autoincrement())
  beachId             BigInt?   @map("beach_id")
  reporterUserId      BigInt?   @map("reporter_user_id")
  reporterToken       String?   @map("reporter_token") @db.VarChar(64)
  lat                 Decimal?  @db.Decimal(10, 7)
  lng                 Decimal?  @db.Decimal(10, 7)
  imageUrl            String    @map("image_url") @db.VarChar(500)
  thumbnailUrl        String?   @map("thumbnail_url") @db.VarChar(500)
  reportType          String    @map("report_type") @db.VarChar(20) // general/multiple/sting
  status              String    @default("received") @db.VarChar(20) // received/ai_processing/ai_done/verified/rejected/hold/reflected
  aiResult            String?   @map("ai_result") @db.VarChar(20) // normal/toxic_suspected/unknown
  aiConfidence        Decimal?  @map("ai_confidence") @db.Decimal(5, 4)
  duplicateOfReportId BigInt?   @map("duplicate_of_report_id")
  occurredAt          DateTime  @map("occurred_at") @db.DateTime(0)
  submittedAt         DateTime  @default(now()) @map("submitted_at") @db.DateTime(0)
  reflectedAt         DateTime? @map("reflected_at") @db.DateTime(0)
  purgeScheduledAt    DateTime? @map("purge_scheduled_at") @db.DateTime(0)

  beach          Beach?            @relation(fields: [beachId], references: [id], onDelete: Restrict)
  reporter       User?             @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  duplicateOf    JellyfishReport?  @relation("ReportDuplicate", fields: [duplicateOfReportId], references: [id], onDelete: SetNull)
  duplicates     JellyfishReport[] @relation("ReportDuplicate")
  consents       ReportConsent[]
  visionResults  VisionResult[]
  reviews        ReportReview[]
  triggeredCalcs RiskCalculation[]
  riskFactors    RiskFactor[]

  @@index([beachId, submittedAt], name: "ix_jellyfish_reports_beach_time")
  @@index([status, submittedAt], name: "ix_jellyfish_reports_status_time")
  @@index([aiResult, submittedAt], name: "ix_jellyfish_reports_ai_result")
  @@index([beachId, occurredAt, reportType], name: "ix_jellyfish_reports_dup_window")
  @@index([reporterToken, submittedAt], name: "ix_jellyfish_reports_reporter")
  @@map("jellyfish_reports")
}

model ReportConsent {
  id           BigInt   @id @default(autoincrement())
  reportId     BigInt   @map("report_id")
  consentLogId BigInt   @map("consent_log_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)

  report     JellyfishReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  consentLog ConsentLog      @relation(fields: [consentLogId], references: [id], onDelete: Restrict)

  @@unique([reportId, consentLogId], name: "uk_report_consents_pair")
  @@map("report_consents")
}

model VisionResult {
  id            BigInt    @id @default(autoincrement())
  reportId      BigInt    @map("report_id")
  modelName     String    @default("VISION_MOCK") @map("model_name") @db.VarChar(100)
  modelVersion  String?   @map("model_version") @db.VarChar(30)
  result        String?   @db.VarChar(20) // normal/toxic_suspected/unknown
  confidence    Decimal?  @db.Decimal(5, 4)
  processStatus String    @default("pending") @map("process_status") @db.VarChar(20) // pending/processing/done/failed
  errorMessage  String?   @map("error_message") @db.VarChar(500)
  rawResponse   Json?     @map("raw_response")
  isLatest      Boolean?  @map("is_latest")
  requestedAt   DateTime  @default(now()) @map("requested_at") @db.DateTime(0)
  processedAt   DateTime? @map("processed_at") @db.DateTime(0)

  report JellyfishReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, isLatest], name: "uk_vision_results_latest")
  @@index([processStatus, requestedAt], name: "ix_vision_results_status")
  @@map("vision_results")
}

model ReportReview {
  id            BigInt   @id @default(autoincrement())
  reportId      BigInt   @map("report_id")
  reviewStatus  String   @map("review_status") @db.VarChar(20) // verified/rejected/hold
  rejectReason  String?  @map("reject_reason") @db.VarChar(30) // not_jellyfish/unclear/duplicate/wrong_location/inappropriate
  memo          String?  @db.VarChar(500)
  reflectedRisk Boolean  @default(false) @map("reflected_risk")
  reviewedBy    BigInt   @map("reviewed_by")
  reviewedAt    DateTime @default(now()) @map("reviewed_at") @db.DateTime(0)

  report   JellyfishReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reviewer User            @relation(fields: [reviewedBy], references: [id], onDelete: Restrict)

  @@index([reportId, reviewedAt], name: "ix_report_reviews_report_time")
  @@index([reviewedBy, reviewedAt], name: "ix_report_reviews_reviewer")
  @@map("report_reviews")
}

// =====================================================================================
// 4. 위험도 산출 (SYS-003)
// =====================================================================================

model RiskRuleConfig {
  id            BigInt   @id @default(autoincrement())
  ruleCode      String   @map("rule_code") @db.VarChar(50)
  ruleCategory  String   @map("rule_category") @db.VarChar(30) // risk_variable/report_weight/level_threshold/min_level
  ruleName      String   @map("rule_name") @db.VarChar(150)
  score         Int?     @db.SmallInt
  conditionJson Json?    @map("condition_json")
  minRiskLevel  String?  @map("min_risk_level") @db.VarChar(20) // safe/caution/danger/severe
  version       String   @default("v1") @db.VarChar(20)
  active        Boolean  @default(true)
  updatedBy     BigInt?  @map("updated_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  updater User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([ruleCode, version], name: "uk_risk_rule_configs_code_version")
  @@index([active, ruleCategory], name: "ix_risk_rule_configs_active")
  @@map("risk_rule_configs")
}

model RiskCalculation {
  id                 BigInt    @id @default(autoincrement())
  calculationUid     String    @unique @map("calculation_uid") @db.VarChar(50)
  triggerType        String    @map("trigger_type") @db.VarChar(30) // schedule/data_sync/report_verified/manual
  triggerReportId    BigInt?   @map("trigger_report_id")
  triggeredBy        BigInt?   @map("triggered_by")
  ruleVersion        String    @map("rule_version") @db.VarChar(20)
  affectedBeachCount Int       @default(0) @map("affected_beach_count")
  calcStatus         String    @default("running") @map("calc_status") @db.VarChar(20) // running/success/partial/failed
  errorMessage       String?   @map("error_message") @db.VarChar(500)
  startedAt          DateTime  @default(now()) @map("started_at") @db.DateTime(0)
  finishedAt         DateTime? @map("finished_at") @db.DateTime(0)

  triggerReport JellyfishReport? @relation(fields: [triggerReportId], references: [id], onDelete: SetNull)
  triggerer     User?            @relation(fields: [triggeredBy], references: [id], onDelete: SetNull)
  riskScores    RiskScore[]

  @@index([startedAt], name: "ix_risk_calculations_time")
  @@map("risk_calculations")
}

model RiskScore {
  id               BigInt   @id @default(autoincrement())
  calculationId    BigInt   @map("calculation_id")
  beachId          BigInt   @map("beach_id")
  horizon          String   @db.VarChar(10) // now/6h/24h/72h
  riskScore        Int      @map("risk_score") @db.SmallInt
  riskLevel        String   @map("risk_level") @db.VarChar(20) // safe/caution/danger/severe
  baseRiskLevel    String?  @map("base_risk_level") @db.VarChar(20)
  minLevelApplied  Boolean  @default(false) @map("min_level_applied")
  minLevelRuleCode String?  @map("min_level_rule_code") @db.VarChar(50)
  dataConfidence   String   @default("medium") @map("data_confidence") @db.VarChar(10) // high/medium/low
  ruleVersion      String   @map("rule_version") @db.VarChar(20)
  modelId          BigInt?  @map("model_id")
  isLatest         Boolean? @map("is_latest")
  generatedAt      DateTime @default(now()) @map("generated_at") @db.DateTime(0)

  calculation      RiskCalculation   @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  beach            Beach             @relation(fields: [beachId], references: [id], onDelete: Cascade)
  model            MlModel?          @relation(fields: [modelId], references: [id], onDelete: SetNull)
  factors          RiskFactor[]
  operationActions OperationAction[]

  @@unique([beachId, horizon, isLatest], name: "uk_risk_scores_latest")
  @@index([calculationId], name: "ix_risk_scores_calculation")
  @@index([riskLevel, generatedAt], name: "ix_risk_scores_level")
  @@map("risk_scores")
}

model RiskFactor {
  id             BigInt  @id @default(autoincrement())
  riskScoreId    BigInt  @map("risk_score_id")
  factorCode     String  @map("factor_code") @db.VarChar(50)
  factorName     String  @map("factor_name") @db.VarChar(150)
  factorDetail   String? @map("factor_detail") @db.VarChar(500)
  scoreDelta     Int     @map("score_delta") @db.SmallInt
  sourceReportId BigInt? @map("source_report_id")
  displayOrder   Int     @default(0) @map("display_order") @db.SmallInt

  riskScore    RiskScore        @relation(fields: [riskScoreId], references: [id], onDelete: Cascade)
  sourceReport JellyfishReport? @relation(fields: [sourceReportId], references: [id], onDelete: SetNull)

  @@index([riskScoreId, displayOrder], name: "ix_risk_factors_score_order")
  @@map("risk_factors")
}

// =====================================================================================
// 5. 운영 대응 (ADM-006/007)
